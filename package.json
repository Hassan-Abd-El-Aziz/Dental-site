{
  "name": "hassan-dental",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "start": "vite --open",
    "build": "vite build && node scripts/prerender.js",
    "build:gh-pages": "vite build --base=/Dental-site/ && node scripts/prerender.js",
    "preview": "vite preview --open",
    "build:client": "vite build",
    "predeploy": "npm run build:gh-pages",
    "deploy": "gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^6.2.0"
  }
}
